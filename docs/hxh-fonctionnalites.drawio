NJ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="190" width="180" height="80" as="geometry"/></mxCell><mxCell id="e13" style="endArrow=block;html=1;strokeColor=#999999;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;J6 — Quêtes et Examen v1&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Moteur JSON, marathon, chasse, licence&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1220" y="190" width="180" height="80" as="geometry"/></mxCell><mxCell id="e15" style="endArrow=block;html=1;strokeColor=#999999;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;J7 — Tour Céleste&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Tranches, arène et tour d'Evan, chambres&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="310" width="180" height="80" as="geometry"/></mxCell><mxCell id="e17" style="endArrow=block;html=1;strokeColor=#999999;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;J7b — Carnet et entraînement&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Carnet, talent, haltères, tapis, quêtes multiples&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="310" width="180" height="80" as="geometry"/></mxCell><mxCell id="e19" style="endArrow=block;html=1;strokeColor=#999999;" edge="1" parent="1" source="c16" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;J8 — Examen Hunter v2&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Guide, dirigeables, 12 épreuves tirées au sort (4 à 6), tournoi final ; reste : structures d'Evan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="310" width="180" height="80" as="geometry"/></mxCell><mxCell id="e21" style="endArrow=block;html=1;strokeColor=#999999;" edge="1" parent="1" source="c18" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;J9 — Marchands et Jenny&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Boutiques JSON, gamme III, ordinateur Hunter&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="310" width="180" height="80" as="geometry"/></mxCell><mxCell id="e23" style="endArrow=block;html=1;strokeColor=#999999;" edge="1" parent="1" source="c20" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;J10 — Monde HxH&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Carte fixe, premières régions, bestiaire&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="310" width="180" height="80" as="geometry"/></mxCell><mxCell id="e25" style="endArrow=block;html=1;strokeColor=#999999;" edge="1" parent="1" source="c22" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;J11 — Grandes régions&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Kukuroo, York Shin, Greed Island, NGL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="310" width="180" height="80" as="geometry"/></mxCell><mxCell id="e27" style="endArrow=block;html=1;strokeColor=#999999;" edge="1" parent="1" source="c24" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Fin — Finitions&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Modèles, animations, rééquilibrage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1220" y="310" width="180" height="80" as="geometry"/></mxCell><mxCell id="e29" style="endArrow=block;html=1;strokeColor=#999999;" edge="1" parent="1" source="c26" target="c28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;Fait les 7–8 novembre 2026&lt;/b&gt; (vert)" style="text;html=1;fontSize=16;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="1400" height="30" as="geometry"/></mxCell><mxCell id="d0" value="&lt;b&gt;Combat vivant&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Animations de poings, frappe chargée, coup de pied ; peur façon Roi (dézoom panique)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="455" width="220" height="80" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;Interface manga&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Jauge penchée, bulle de quête, notifications, police Bangers, animations&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="255" y="455" width="220" height="80" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;Effets dessinés&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;NenFx : chaînes de Kurapika, éclairs, impacts, aiguilles — sans particules vanilla&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="455" width="220" height="80" as="geometry"/></mxCell><mxCell id="d3" value="&lt;b&gt;Quêtes faciles&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;JSON avec textes, PNJ donneur, bring/reach/custom, /hunter quest check&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="725" y="455" width="220" height="80" as="geometry"/></mxCell><mxCell id="d4" value="&lt;b&gt;Jajanken fidèle&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Pierre chargée (boule qui grossit, tir de 20 blocs, destruction), Ciseaux en lame&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="455" width="220" height="80" as="geometry"/></mxCell><mxCell id="d5" value="&lt;b&gt;Tour garantie&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Posée dans une plaine au démarrage ; vitesse réglable, montée de blocs, mannequin&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1195" y="455" width="220" height="80" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Prochaines itérations — propositions d'Evan&lt;/b&gt; (rouge = à faire en priorité, jaune = en attente de réponse)" style="text;html=1;fontSize=16;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="1400" height="30" as="geometry"/></mxCell><mxCell id="v0" value="&lt;b&gt;À faire ensuite&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;b&gt;Dirigeables&lt;/b&gt; pour voyager dans le monde (demande d'Evan) · &lt;b&gt;Structures du dirigeable&lt;/b&gt; (extérieur hxh:exam/dirigeable, salle de la balle) · Examen : vraies structures, apparences des PNJ (maris, Kiriko, gérant), forme du Kiriko révélé&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="595" width="1395" height="100" as="geometry"/></mxCell><mxCell id="u3" value="&lt;b&gt;Épreuves de l'Examen (manga + anime)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Bateau pour Dolle (quiz du capitaine, tempête), quiz de la Mamie (silence), brouillard de Numele et faux Satotz, sushi de Menchi, saut au mont Split (œufs, courant ascendant), île de Zevil (plaques : 3/3/1, 6 points). Parcours tiré au sort : trouver un guide, aller à pied au dirigeable de chaque épreuve (hôtesse, embarquer), retour au dirigeable après chaque épreuve, jeu de la balle de Netero, Tour de Trick (trappes, vote de la majorité avec Tonpa, long chemin, prisonniers Majitani/Jo-ness/Leroute, escalier piégé, horloge 5 min), forêt des Kiriko (démasquer le faux mari), île-hôtel du hors-série 1999 (plongée à l'épave, vague et canons), 288e Examen de l'OVA (assommer 10 candidats en 60 s), 4 à 6 épreuves liées et ordonnées, toujours les badges de Zevil puis le tournoi final de Netero (abandon, repêchage), échec = nouveau tirage dans des lieux jamais vus ; l'Examen est la 1re quête du joueur&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="725" y="835" width="220" height="100" as="geometry"/></mxCell><mxCell id="t0" value="&lt;b&gt;Apprendre le Nen avec un maître&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Un PNJ maître donne une quête par capacité (Ten, Zetsu, Ren, Hatsu…) ; /hunter max débloque tout&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="715" width="220" height="100" as="geometry"/></mxCell><mxCell id="t1" value="&lt;b&gt;Coups de base dans le menu des pouvoirs&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Coup, coup de pied, frappe chargée avec recharge et dégâts visibles, menu dès le début ; plus d'animation sur le clic main vide&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="255" y="715" width="220" height="100" as="geometry"/></mxCell><mxCell id="t2" value="&lt;b&gt;Impacts puissants par paliers&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Force ≥ 25 % : éclats ; ≥ 50 % : blocs qui sautent ; ≥ 75 % : cratère, image d'impact (figé 0,8 s), murs défoncés&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="715" width="220" height="100" as="geometry"/></mxCell><mxCell id="t3" value="&lt;b&gt;Refonte DA des sorts&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Gon (Papier), Killua (Foudre, Godspeed), Leorio (portails), Illumi (aiguilles), Pitou (fils). Kurapika déjà en chaînes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="725" y="715" width="220" height="100" as="geometry"/></mxCell><mxCell id="t4" value="&lt;b&gt;Plus tard (priorité faible)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Modèle 3D de la poupée de Docteur Blythe (prototype en blocs en place) ; verre de divination animé&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="715" width="220" height="100" as="geometry"/></mxCell><mxCell id="t5" value="&lt;b&gt;Derniers effets vanilla&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Faits : contour En/Gyo à la couleur d'aura, mort des mobs en étoile d'encre&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1195" y="715" width="220" height="100" as="geometry"/></mxCell><mxCell id="u0" value="&lt;b&gt;Jajanken en deux versions&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Pierre normale (demi-joueur, couleurs) ; Pierre sans retenue (enfle, se recondense, éblouit)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="835" width="220" height="100" as="geometry"/></mxCell><mxCell id="u1" value="&lt;b&gt;Aura, Ren et En refaits&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Vapeur au repos/Ten, flammes au Ren/Ken, aura « sauvage » (flammes même au repos), dôme d'En&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="255" y="835" width="220" height="100" as="geometry"/></mxCell><mxCell id="u2" value="&lt;b&gt;Ryu en attaque&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Pierre ×1,5 à 100 % ; à 75 %+ l'aura quitte le corps et brûle aux poings&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="835" width="220" height="100" as="geometry"/></mxCell><mxCell id="n3" value="Fait le 13 novembre 2026 (vert)" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="955" width="1400" height="30" as="geometry"/></mxCell><mxCell id="e0" value="&lt;b&gt;Coups secrets de famille&lt;/b&gt;&lt;br&gt;Main-griffe, Colère écarlate, Instinct du chasseur, Premiers soins ; sans Nen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="990" width="220" height="80" as="geometry"/></mxCell><mxCell id="e1" value="&lt;b&gt;Serments et restrictions&lt;/b&gt;&lt;br&gt;6 serments, ×1,25 à ×3 ; rupture = Hatsu scellé ; écran Serments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="255" y="990" width="220" height="80" as="geometry"/></mxCell><mxCell id="e2" value="&lt;b&gt;Enchères de York Shin&lt;/b&gt;&lt;br&gt;4 lots par jour, gamme IV et reliques, enchérisseurs PNJ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="990" width="220" height="80" as="geometry"/></mxCell><mxCell id="e3" value="&lt;b&gt;Combattants du 200e&lt;/b&gt;&lt;br&gt;Gido, Sadaso, Riehlvelt, Kastro et leurs techniques" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="725" y="990" width="220" height="80" as="geometry"/></mxCell><mxCell id="e4" value="&lt;b&gt;Paris sur les combats&lt;/b&gt;&lt;br&gt;Cote selon les niveaux, liens cliquables, gains à la fin du combat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1085" width="220" height="80" as="geometry"/></mxCell><mxCell id="e5" value="&lt;b&gt;Exorcisme de Nen&lt;/b&gt;&lt;br&gt;Malédiction posthume, exorciste : malédiction, Hakoware, bombe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="255" y="1085" width="220" height="80" as="geometry"/></mxCell><mxCell id="e6" value="&lt;b&gt;Contrats Zoldyck&lt;/b&gt;&lt;br&gt;Majordome, cible nommée lointaine, délai, bonus Zoldyck" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="1085" width="220" height="80" as="geometry"/></mxCell><mxCell id="e7" value="&lt;b&gt;Rang Hunter et Blacklist&lt;/b&gt;&lt;br&gt;Étoiles par domaine, traques cliquables depuis l&#x27;ordinateur Hunter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="725" y="1085" width="220" height="80" as="geometry"/></mxCell><mxCell id="e8" value="&lt;b&gt;Quêtes d&#x27;organisation&lt;/b&gt;&lt;br&gt;Beans, Chrollo, Genthru ; Cheadle ouvre les Zodiaques" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="1085" width="220" height="80" as="geometry"/></mxCell><mxCell id="e9" value="&lt;b&gt;Hunter gourmet&lt;/b&gt;&lt;br&gt;Plats après sa quête ; quête finale → carnet de recettes (renard-ours)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1180" width="220" height="80" as="geometry"/></mxCell><mxCell id="e10" value="&lt;b&gt;Bestiaire et Tour&lt;/b&gt;&lt;br&gt;Renard-ours, Great Stamp ; Hisoka au 235–240e ; ratés destructeurs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="255" y="1180" width="220" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="Structures à construire"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1560" pageHeight="1394"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Structures à construire&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;vert = fait · rouge = à faire en priorité · orange = à faire · gris = plus tard. Sauvegarde avec /hunter structure save &amp;lt;fichier&amp;gt; X1 Y1 Z1 X2 Y2 Z2. Guide : docs/tour-celeste-constructions.md&lt;/font&gt;" style="text;html=1;fontSize=22;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="60" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Tour Céleste&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="1508" height="360" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Tour extérieure&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555555'&gt;Fait · fichier : hxh:heavens_arena/tour&lt;/font&gt;&lt;br&gt;&lt;u&gt;Repères et blocs&lt;/u&gt;&lt;br&gt;• Portails d'entrée (bloc « Portail de la Tour Céleste »)&lt;br&gt;&lt;u&gt;Contenu&lt;/u&gt;&lt;br&gt;• Générée une fois par monde dans l'Overworld" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="240" width="360" height="163" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Arène modèle (toutes les tranches)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555555'&gt;Fait · fichier : hxh:heavens_arena/arene&lt;/font&gt;&lt;br&gt;&lt;u&gt;Repères et blocs&lt;/u&gt;&lt;br&gt;• J, A, E, H ×4, R ×4, ascenseurs, sortie&lt;br&gt;&lt;u&gt;Contenu&lt;/u&gt;&lt;br&gt;• Ring 21 × 21 (ring_radius 10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="402" y="240" width="360" height="163" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Hall d'entrée (étage 0)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555555'&gt;Priorité haute · fichier : hxh:heavens_arena/lobby&lt;/font&gt;&lt;br&gt;&lt;u&gt;Repères et blocs&lt;/u&gt;&lt;br&gt;• E (arrivée)&lt;br&gt;• H (au moins 1 hôtesse)&lt;br&gt;• Ascenseur&lt;br&gt;• Sortie&lt;br&gt;&lt;u&gt;Contenu&lt;/u&gt;&lt;br&gt;• Remplace le hall généré par le code&lt;br&gt;• Guichet d'inscription, ambiance hall d'hôtel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="774" y="240" width="360" height="163" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Chambre type&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555555'&gt;Priorité haute · fichier : hxh:heavens_arena/room&lt;/font&gt;&lt;br&gt;&lt;u&gt;Repères et blocs&lt;/u&gt;&lt;br&gt;• E (arrivée)&lt;br&gt;• Ascenseur&lt;br&gt;&lt;u&gt;Contenu&lt;/u&gt;&lt;br&gt;• Lit, coffre, établi, déco&lt;br&gt;• Chaque joueur en reçoit une copie qu'il peut décorer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1146" y="240" width="360" height="163" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Hall du 200e étage&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555555'&gt;À faire · fichier : hxh:heavens_arena/hall_200&lt;/font&gt;&lt;br&gt;&lt;u&gt;Repères et blocs&lt;/u&gt;&lt;br&gt;• E, H, R, J, A, ascenseur&lt;br&gt;&lt;u&gt;Contenu&lt;/u&gt;&lt;br&gt;• Inscription au 200e, ambiance plus sombre&lt;br&gt;• Couloir où « Hisoka » bloquera l'accès (quête à venir)&lt;br&gt;• Nécessitera une tranche « 200 » à part" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="415" width="360" height="133" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Halls par palier (1–50, 51–100, 101–150, 151–200)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555555'&gt;À faire · fichier : tranche_001_050 … tranche_151_200&lt;/font&gt;&lt;br&gt;&lt;u&gt;Repères et blocs&lt;/u&gt;&lt;br&gt;• E, H, R, J, A, ascenseur&lt;br&gt;&lt;u&gt;Contenu&lt;/u&gt;&lt;br&gt;• Un style par palier, plus grand et plus beau à chaque fois&lt;br&gt;• Fichiers de tranche : 001_050.json, etc." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="402" y="415" width="360" height="133" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Halls 201–250 (tranches de 5)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555555'&gt;Plus tard · fichier : tranche_201_205 … tranche_246_250&lt;/font&gt;&lt;br&gt;&lt;u&gt;Repères et blocs&lt;/u&gt;&lt;br&gt;• E, H, R, J, A, ascenseur&lt;br&gt;&lt;u&gt;Contenu&lt;/u&gt;&lt;br&gt;• Peuvent partager 2 ou 3 styles « Nen »" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="774" y="415" width="360" height="133" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Sommet (251, Maître d'étage)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555555'&gt;À faire · fichier : tranche_251&lt;/font&gt;&lt;br&gt;&lt;u&gt;Repères et blocs&lt;/u&gt;&lt;br&gt;• E, H, R, J, A, ascenseur&lt;br&gt;&lt;u&gt;Contenu&lt;/u&gt;&lt;br&gt;• Salle du trône du Maître d'étage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1146" y="415" width="360" height="133" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Examen Hunter (rien n'existe encore : PNJ posés par /hunter exam setup)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="580" width="1508" height="505" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Port de Dolle&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555555'&gt;À faire · fichier : hxh:exam/dolle&lt;/font&gt;&lt;br&gt;&lt;u&gt;Repères et blocs&lt;/u&gt;&lt;br&gt;• E (arrivée)&lt;br&gt;• P réglé sur Navigateur&lt;br&gt;&lt;u&gt;Contenu&lt;/u&gt;&lt;br&gt;• Petit port, quais, auberge&lt;br&gt;• Étape 1 : parler au Navigateur" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="620" width="360" height="163" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Zaban : restaurant + ascenseur&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555555'&gt;Priorité haute · fichier : hxh:exam/zaban_restaurant&lt;/font&gt;&lt;br&gt;&lt;u&gt;Repères et blocs&lt;/u&gt;&lt;br&gt;• E&lt;br&gt;• P réglé sur Cuisinier de Zaban&lt;br&gt;&lt;u&gt;Contenu&lt;/u&gt;&lt;br&gt;• Gargote de la rue Tsubashi&lt;br&gt;• Le bon plat fait descendre la salle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="402" y="620" width="360" height="163" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Hall d'inscription souterrain&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555555'&gt;Priorité haute · fichier : hxh:exam/hall_inscription&lt;/font&gt;&lt;br&gt;&lt;u&gt;Repères et blocs&lt;/u&gt;&lt;br&gt;• E&lt;br&gt;• P = Beans&lt;br&gt;• P = Satotz (départ du marathon)&lt;br&gt;&lt;u&gt;Contenu&lt;/u&gt;&lt;br&gt;• Grande salle sous terre, 405 candidats&lt;br&gt;• Étapes 2 et 3 : badge chez Beans, rejoindre Satotz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="774" y="620" width="360" height="163" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Tunnel du marathon&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555555'&gt;Priorité haute · fichier : hxh:exam/tunnel&lt;/font&gt;&lt;br&gt;&lt;u&gt;Repères et blocs&lt;/u&gt;&lt;br&gt;• Points de parcours n°1 → n°N (le plus grand = arrivée)&lt;br&gt;&lt;u&gt;Contenu&lt;/u&gt;&lt;br&gt;• Long tunnel puis escalier sans fin, chemin de 3 blocs de large&lt;br&gt;• Satotz suit les points ; distancé plus de 5 s = examen raté&lt;br&gt;• Le plus simple : dans la même structure que le hall" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1146" y="620" width="360" height="163" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Réserve de Biska : cuisine de Menchi et Buhara&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555555'&gt;Priorité haute · fichier : hxh:exam/biska&lt;/font&gt;&lt;br&gt;&lt;u&gt;Repères et blocs&lt;/u&gt;&lt;br&gt;• E&lt;br&gt;• P = Buhara&lt;br&gt;• P = Menchi&lt;br&gt;• G (apparition de proies, plusieurs)&lt;br&gt;&lt;u&gt;Contenu&lt;/u&gt;&lt;br&gt;• Clairière, cuisine en plein air, grand portail&lt;br&gt;• Étapes 5 à 7 : chasse des porcs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="795" width="360" height="163" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Salle de la licence (hôtel de l'Association)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555555'&gt;Priorité haute · fichier : hxh:exam/hotel&lt;/font&gt;&lt;br&gt;&lt;u&gt;Repères et blocs&lt;/u&gt;&lt;br&gt;• E&lt;br&gt;• P = Netero&lt;br&gt;&lt;u&gt;Contenu&lt;/u&gt;&lt;br&gt;• Salle où Netero remet la licence&lt;br&gt;• Plus tard : salle du tournoi final" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="402" y="795" width="360" height="163" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Marais de Numele (sortie du tunnel)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555555'&gt;À faire · fichier : hxh:exam/numele&lt;/font&gt;&lt;br&gt;&lt;u&gt;Repères et blocs&lt;/u&gt;&lt;br&gt;• Arrivée, sortie vers Biska&lt;br&gt;&lt;u&gt;Contenu&lt;/u&gt;&lt;br&gt;• Brouillard, arbres morts, mobs pièges" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="774" y="795" width="360" height="163" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Mont Split (œufs d'aigle-araignée)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555555'&gt;Plus tard · fichier : hxh:exam/mont_split&lt;/font&gt;&lt;br&gt;&lt;u&gt;Repères et blocs&lt;/u&gt;&lt;br&gt;• Arrivée, nid&lt;br&gt;&lt;u&gt;Contenu&lt;/u&gt;&lt;br&gt;• Ravin avec fils et œufs à cueillir" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1146" y="795" width="360" height="163" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Dirigeable de l'Association&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555555'&gt;Plus tard · fichier : hxh:exam/dirigeable&lt;/font&gt;&lt;br&gt;&lt;u&gt;Repères et blocs&lt;/u&gt;&lt;br&gt;• Netero, arrivée&lt;br&gt;&lt;u&gt;Contenu&lt;/u&gt;&lt;br&gt;• Transport entre les épreuves, mini-jeu du ballon" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="970" width="360" height="103" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Tour de Trick&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555555'&gt;Plus tard · fichier : hxh:exam/tour_de_trick&lt;/font&gt;&lt;br&gt;&lt;u&gt;Repères et blocs&lt;/u&gt;&lt;br&gt;• Sommet, salles, sortie&lt;br&gt;&lt;u&gt;Contenu&lt;/u&gt;&lt;br&gt;• Descente par des pièges, chemin de la majorité" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="402" y="970" width="360" height="103" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Île de Zevil&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555555'&gt;Plus tard · fichier : hxh:exam/zevil&lt;/font&gt;&lt;br&gt;&lt;u&gt;Repères et blocs&lt;/u&gt;&lt;br&gt;• Arrivée, cibles&lt;br&gt;&lt;u&gt;Contenu&lt;/u&gt;&lt;br&gt;• Île de survie, chasse aux plaques" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="774" y="970" width="360" height="103" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Monde (avec la carte HxH, plus tard)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="1105" width="1508" height="155" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Île de la Baleine&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555555'&gt;Plus tard · fichier : hxh:world/whale_island&lt;/font&gt;&lt;br&gt;&lt;u&gt;Repères et blocs&lt;/u&gt;&lt;br&gt;• Mito, point de départ&lt;br&gt;&lt;u&gt;Contenu&lt;/u&gt;&lt;br&gt;• Village, maison de Mito, forêt, lac du Seigneur" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1145" width="360" height="103" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Mont Kukuroo et domaine Zoldyck&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555555'&gt;Plus tard · fichier : hxh:world/kukuroo&lt;/font&gt;&lt;br&gt;&lt;u&gt;Repères et blocs&lt;/u&gt;&lt;br&gt;• Zebro, Mike, majordomes&lt;br&gt;&lt;u&gt;Contenu&lt;/u&gt;&lt;br&gt;• Porte de l'épreuve, manoir" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="402" y="1145" width="360" height="103" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;York Shin, Étoile filante, Greed Island, NGL…&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555555'&gt;Plus tard · fichier : hxh:world/…&lt;/font&gt;&lt;br&gt;&lt;u&gt;Repères et blocs&lt;/u&gt;&lt;br&gt;• Selon le lieu&lt;br&gt;&lt;u&gt;Contenu&lt;/u&gt;&lt;br&gt;• Voir l'encyclopédie de contenu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="774" y="1145" width="360" height="103" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Repères&lt;/b&gt;&lt;br&gt;• E (vert) : arrivée / apparition&lt;br&gt;• H (jaune) : hôtesse&lt;br&gt;• R (gris) : arbitre&lt;br&gt;• J (bleu) : départ du joueur&lt;br&gt;• A (rouge) : départ de l'adversaire&lt;br&gt;• P (violet, réglable au clic droit) : PNJ&lt;br&gt;• # (orange, réglable) : point de parcours, le plus grand = arrivée&lt;br&gt;• G (marron) : apparition de proies&lt;br&gt;• Guide : docs/examen-constructions.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1280" width="700" height="174" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>