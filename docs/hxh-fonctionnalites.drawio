<mxfile host="app.diagrams.net"><diagram id="p1" name="Fonctionnalités"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="1846"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c2" value="&lt;b&gt;HxH Mod — fonctionnalités&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;NeoForge 1.21.1 · état au 6 novembre 2026&lt;/font&gt;" style="text;html=1;fontSize=22;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="50" as="geometry" /></mxCell><mxCell id="c3" value="&lt;b&gt;Fait&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#82b366;fontColor=#ffffff;fontSize=15;" vertex="1" parent="1"><mxGeometry x="180" y="70" width="380" height="34" as="geometry" /></mxCell><mxCell id="c4" value="&lt;b&gt;Prochaines étapes&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#d79b00;fontColor=#ffffff;fontSize=15;" vertex="1" parent="1"><mxGeometry x="570" y="70" width="380" height="34" as="geometry" /></mxCell><mxCell id="c5" value="&lt;b&gt;Idées à venir&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#6c8ebf;fontColor=#ffffff;fontSize=15;" vertex="1" parent="1"><mxGeometry x="960" y="70" width="380" height="34" as="geometry" /></mxCell><mxCell id="c6" value="&lt;b&gt;Joueur et stats&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="114.0" width="150" height="98" as="geometry" /></mxCell><mxCell id="c7" value="• 5 stats gagnées par l'entraînement (Force, Vitesse, Endurance, Vitalité, Volonté)&lt;br&gt;• Niveau Hunter, XP par usage&lt;br&gt;• Chiffres flottants de dégâts et de soin&lt;br&gt;• Carnet de Hunter (touche O)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="180" y="114.0" width="380" height="98" as="geometry" /></mxCell><mxCell id="c8" value="• Grand rééquilibrage final (dégâts, XP, paliers)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="114.0" width="380" height="98" as="geometry" /></mxCell><mxCell id="c9" value="• Animations du joueur (Player Animator)&lt;br&gt;• Modèles refaits sous Blockbench" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="114.0" width="380" height="98" as="geometry" /></mxCell><mxCell id="c10" value="&lt;b&gt;Nen&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="222.0" width="150" height="188.0" as="geometry" /></mxCell><mxCell id="c11" value="• 3 éveils : méditation, ouverture des pores par un maître, accident&lt;br&gt;• Divination par l'eau, 6 types, hexagone d'affinité&lt;br&gt;• Aura : jauge, régénération, visuel sur le corps&lt;br&gt;• Ten, Zetsu, Ren, In, Ken, Ko, Ryu (écran), Gyo, En, Shu&lt;br&gt;• Niveau de Nen + 10 maîtrises plafonnées&lt;br&gt;• Résistance plate par posture (sauf dégâts internes)&lt;br&gt;• Soin par le Nen (mobs dès le niveau 20)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="180" y="222.0" width="380" height="188.0" as="geometry" /></mxCell><mxCell id="c12" value="• Débloquer le soin par le Nen pour le joueur (à décider)&lt;br&gt;• Talent pour le Nen tiré au hasard en début de partie : XP de Nen ×0,8 à ×4 (7 rangs, de 40 % à 0,1 %)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="222.0" width="380" height="188.0" as="geometry" /></mxCell><mxCell id="c13" value="• Pacte (Vow and Limitation)&lt;br&gt;• Visuels de Hatsu : bloc d'aura sur le poing, traînées de vent&lt;br&gt;• Exorcisme de Nen&lt;br&gt;• Révéler le talent plus tard (maître, ordinateur Hunter) ? À décider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="222.0" width="380" height="188.0" as="geometry" /></mxCell><mxCell id="c14" value="&lt;b&gt;Hatsu et personnages&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="420.0" width="150" height="152.0" as="geometry" /></mxCell><mxCell id="c15" value="• Choix définitif d'un personnage de son type&lt;br&gt;• 6 kits jouables, option « aucun »&lt;br&gt;• Liste des techniques (type, conditions, recharge)&lt;br&gt;• Touches lancer / technique suivante, boîte en bas à droite&lt;br&gt;• Passifs de personnage&lt;br&gt;• Un raté part quand même (coût + recharge)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="180" y="420.0" width="380" height="152.0" as="geometry" /></mxCell><mxCell id="c16" value="• Passer des idées aux kits jouables&lt;br&gt;• Traduire les 37 idées en anglais" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="420.0" width="380" height="152.0" as="geometry" /></mxCell><mxCell id="c17" value="• Techniques destructrices qui cassent les blocs&lt;br&gt;• Kits complets de la Brigade, des Zoldyck, de Kurapika…&lt;br&gt;• Revoir toutes les techniques : plus jolies, animations sur mesure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="420.0" width="380" height="152.0" as="geometry" /></mxCell><mxCell id="c18" value="&lt;b&gt;Combat&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="582.0" width="150" height="116" as="geometry" /></mxCell><mxCell id="c19" value="• Combos, coup de pied&lt;br&gt;• Frappe chargée au bon moment&lt;br&gt;• Peur face à un adversaire bien plus fort" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="180" y="582.0" width="380" height="116" as="geometry" /></mxCell><mxCell id="c20" value="&lt;i&gt;—&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="582.0" width="380" height="116" as="geometry" /></mxCell><mxCell id="c21" value="• Effets de statut de Nen (chaîne du jugement, Hakoware)&lt;br&gt;• Mini-jeux : Gungi, balle aux prisonniers…&lt;br&gt;• Au-delà d'un certain niveau, les coups cassent les blocs autour (ou les font « sauter » puis revenir)&lt;br&gt;• Impact frames sur les gros coups, selon le niveau" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="582.0" width="380" height="116" as="geometry" /></mxCell><mxCell id="c22" value="&lt;b&gt;Mobs et PNJ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="708.0" width="150" height="116" as="geometry" /></mxCell><mxCell id="c23" value="• N'importe quel mob peut avoir le Nen et un Hatsu&lt;br&gt;• Passifs → neutres avec le Nen, agressifs restent agressifs&lt;br&gt;• Persistants, XP, niveau selon le temps de jeu&lt;br&gt;• Niveau au-dessus de la tête, visible au Gyo&lt;br&gt;• PNJ : Navigateur, Beans, Satotz, Buhara, Netero, hôtesses, arbitres" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="180" y="708.0" width="380" height="116" as="geometry" /></mxCell><mxCell id="c24" value="• Mobs qui apparaissent naturellement avec du Nen&lt;br&gt;• Événements aléatoires annoncés dans le chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="708.0" width="380" height="116" as="geometry" /></mxCell><mxCell id="c25" value="• Bestiaire : renard-ours, Kiriko, mobs du marais de Numele, Great Stamp, cyclopes, loups-garous…&lt;br&gt;• Brigade Fantôme, Fourmis-Chimères, Zazan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="708.0" width="380" height="116" as="geometry" /></mxCell><mxCell id="c26" value="&lt;b&gt;Quêtes et Examen&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="834.0" width="150" height="98" as="geometry" /></mxCell><mxCell id="c27" value="• Moteur de quêtes en JSON&lt;br&gt;• Examen Hunter v1 : inscription, marathon de Satotz, chasse de Buhara, licence&lt;br&gt;• Quête du guichet de la Tour Céleste&lt;br&gt;• Suivi de quête à l'écran + onglet Quêtes du carnet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="180" y="834.0" width="380" height="98" as="geometry" /></mxCell><mxCell id="c28" value="• Suite de l'Examen : Zaban et tunnel, Numele, Mont Split, Tour de Trick, île de Zevil, tournoi&lt;br&gt;• Choisir la quête suivie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="834.0" width="380" height="98" as="geometry" /></mxCell><mxCell id="c29" value="• Quête de Hisoka qui bloque l'inscription au 200e&lt;br&gt;• Contrats Zoldyck, tableau de primes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="834.0" width="380" height="98" as="geometry" /></mxCell><mxCell id="c30" value="&lt;b&gt;Tour Céleste&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="942.0" width="150" height="170" as="geometry" /></mxCell><mxCell id="c31" value="• Dimension protégée (ni casse, ni pose, ni téléportation)&lt;br&gt;• Hall d'entrée + 15 tranches, chacune avec ring central, hôtesse, arbitre&lt;br&gt;• Inscription par tranche et au 200e (Nen exigé)&lt;br&gt;• Montée lente, défaite = tranche d'en dessous&lt;br&gt;• 1 combat par ring, file d'attente, spectateurs&lt;br&gt;• Chambre privée par joueur&lt;br&gt;• Maître d'étage au 251e, dialogues adaptés&lt;br&gt;• Halls importables (structures + repères)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="180" y="942.0" width="380" height="170" as="geometry" /></mxCell><mxCell id="c32" value="• Evan : halls plus grands et plus jolis, hall d'entrée, chambre type&lt;br&gt;• Tour physique dans le monde" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="942.0" width="380" height="170" as="geometry" /></mxCell><mxCell id="c33" value="• Halls de plus de 48 blocs en plusieurs morceaux&lt;br&gt;• Boss du 200e : Gido, Riehlvelt, Sadaso, Kastro, Hisoka&lt;br&gt;• Paris sur les combats" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="942.0" width="380" height="170" as="geometry" /></mxCell><mxCell id="c34" value="&lt;b&gt;Monde et structures&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="1122.0" width="150" height="170.0" as="geometry" /></mxCell><mxCell id="c35" value="&lt;i&gt;—&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="180" y="1122.0" width="380" height="170.0" as="geometry" /></mxCell><mxCell id="c36" value="• Type de monde « carte HxH » (carte fixe, océan ailleurs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="1122.0" width="380" height="170.0" as="geometry" /></mxCell><mxCell id="c37" value="• Île de la Baleine, port de Dolle, Zaban, marais de Numele&lt;br&gt;• Mont Kukuroo et domaine Zoldyck&lt;br&gt;• York Shin, Ville de l'Étoile filante + ruche de Zazan&lt;br&gt;• Greed Island (dimension, cartes, sorts)&lt;br&gt;• NGL, Gorteau Est, palais et Ruche&lt;br&gt;• Arbre-Monde ; Continent Noir (bonus)&lt;br&gt;• Aéroports et dirigeables pour voyager entre les lieux (billet en Jenny, gratuit avec la licence)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="1122.0" width="380" height="170.0" as="geometry" /></mxCell><mxCell id="c38" value="&lt;b&gt;Économie&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="1302.0" width="150" height="62" as="geometry" /></mxCell><mxCell id="c39" value="• Jenny gagnés à la Tour et en quêtes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="180" y="1302.0" width="380" height="62" as="geometry" /></mxCell><mxCell id="c40" value="&lt;i&gt;—&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="1302.0" width="380" height="62" as="geometry" /></mxCell><mxCell id="c41" value="• Boutiques, enchères de York Shin&lt;br&gt;• Paris, tableau de primes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="1302.0" width="380" height="62" as="geometry" /></mxCell><mxCell id="c42" value="&lt;b&gt;Interface&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="1374.0" width="150" height="98" as="geometry" /></mxCell><mxCell id="c43" value="• HUD : aura, technique, barre de frappe, quête&lt;br&gt;• Écrans : Hatsu, techniques, Ryu, ascenseur, carnet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="180" y="1374.0" width="380" height="98" as="geometry" /></mxCell><mxCell id="c44" value="&lt;i&gt;—&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="1374.0" width="380" height="98" as="geometry" /></mxCell><mxCell id="c45" value="• Modèles et animations définitifs&lt;br&gt;• Ordinateur Hunter : infos sur le Nen, les Hatsu, les créatures, débloquées au fil du jeu (côté RP)&lt;br&gt;• Menu « wiki » complet, en réserve" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="1374.0" width="380" height="98" as="geometry" /></mxCell><mxCell id="c46" value="&lt;b&gt;Technique&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="1482.0" width="150" height="62" as="geometry" /></mxCell><mxCell id="c47" value="• CI GitHub : compilation, GameTests, client scripté avec captures&lt;br&gt;• Serveur qui fait autorité, synchro partielle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="180" y="1482.0" width="380" height="62" as="geometry" /></mxCell><mxCell id="c48" value="&lt;i&gt;—&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="1482.0" width="380" height="62" as="geometry" /></mxCell><mxCell id="c49" value="&lt;i&gt;—&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="1482.0" width="380" height="62" as="geometry" /></mxCell><mxCell id="n900" value="&lt;b&gt;Entraînement et objets&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="1554.0" width="150" height="188" as="geometry" /></mxCell><mxCell id="n901" value="&lt;i&gt;—&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="180" y="1554.0" width="380" height="188" as="geometry" /></mxCell><mxCell id="n902" value="&lt;i&gt;—&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="1554.0" width="380" height="188" as="geometry" /></mxCell><mxCell id="n903" value="• Haltères (Force)&lt;br&gt;• Tapis de course : mode Vitesse OU mode Endurance, jamais les deux&lt;br&gt;• Vitalité, à rejuger : plats nutritifs, mannequin qui frappe, bain glacé, plats empoisonnés façon Zoldyck&lt;br&gt;• Volonté, dure à entraîner, à rejuger : méditation sous cascade, Zetsu prolongé, résister à la peur, jeûne, épreuves de maître&lt;br&gt;• 4 niveaux pour chaque objet : I fabricable, II amélioré, III marchands, IV rare aux enchères" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="1554.0" width="380" height="188" as="geometry" /></mxCell><mxCell id="n904" value="&lt;b&gt;Organisations&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="1752.0" width="150" height="80" as="geometry" /></mxCell><mxCell id="n905" value="&lt;i&gt;—&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="180" y="1752.0" width="380" height="80" as="geometry" /></mxCell><mxCell id="n906" value="&lt;i&gt;—&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="1752.0" width="380" height="80" as="geometry" /></mxCell><mxCell id="n907" value="• Rejoindre par des quêtes : Brigade Fantôme, groupe de Genthru, Association des Hunters, direction (Zodiaques)…&lt;br&gt;• Chaque organisation : quêtes, alliés, ennemis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="1752.0" width="380" height="80" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="Feuille de route"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="2600" pageHeight="260"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c2" value="&lt;b&gt;Feuille de route — jalons&lt;/b&gt;" style="text;html=1;fontSize=22;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="600" height="40" as="geometry" /></mxCell><mxCell id="c3" value="&lt;b&gt;J0 — Dépôt et squelette&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;CI GitHub qui compile, teste et joue&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="170" height="80" as="geometry" /></mxCell><mxCell id="c4" value="&lt;b&gt;J1 — Données joueur&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Stats, XP, sauvegarde, synchro, /hunter&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="210" y="70" width="170" height="80" as="geometry" /></mxCell><mxCell id="e5" style="endArrow=block;html=1;strokeColor=#999999;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c6" value="&lt;b&gt;J2 — Aura et Nen de base&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Jauge, Ten/Zetsu/Ren, éveil, divination&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="70" width="170" height="80" as="geometry" /></mxCell><mxCell id="e7" style="endArrow=block;html=1;strokeColor=#999999;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c8" value="&lt;b&gt;J3 — Hatsu&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Choix du personnage, 6 kits, techniques&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="70" width="170" height="80" as="geometry" /></mxCell><mxCell id="e9" style="endArrow=block;html=1;strokeColor=#999999;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c10" value="&lt;b&gt;J4 — Combat + Nen avancé&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Combos, frappe chargée, peur, Gyo/Ken/Ko/Ryu/En/Shu&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="70" width="170" height="80" as="geometry" /></mxCell><mxCell id="e11" style="endArrow=block;html=1;strokeColor=#999999;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c12" value="&lt;b&gt;J5 — Mobs au Nen&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;IA, niveaux, persistance, PNJ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970" y="70" width="170" height="80" as="geometry" /></mxCell><mxCell id="e13" style="endArrow=block;html=1;strokeColor=#999999;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c14" value="&lt;b&gt;J6 — Quêtes et Examen v1&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Moteur JSON, marathon, chasse, licence&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="70" width="170" height="80" as="geometry" /></mxCell><mxCell id="e15" style="endArrow=block;html=1;strokeColor=#999999;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c16" value="&lt;b&gt;J7 — Tour Céleste&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Tranches, rings, Jenny, chambres, carnet&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1350" y="70" width="170" height="80" as="geometry" /></mxCell><mxCell id="e17" style="endArrow=block;html=1;strokeColor=#999999;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c18" value="&lt;b&gt;J8 — Suite de l'Examen&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Zaban, Numele, Tour de Trick, Zevil, tournoi&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1540" y="70" width="170" height="80" as="geometry" /></mxCell><mxCell id="e19" style="endArrow=block;html=1;strokeColor=#999999;" edge="1" parent="1" source="c16" target="c18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c20" value="&lt;b&gt;J9 — Monde HxH&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Carte fixe, premières structures, bestiaire&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1730" y="70" width="170" height="80" as="geometry" /></mxCell><mxCell id="e21" style="endArrow=block;html=1;strokeColor=#999999;" edge="1" parent="1" source="c18" target="c20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c22" value="&lt;b&gt;J10 — Économie&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Boutiques, enchères, primes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1920" y="70" width="170" height="80" as="geometry" /></mxCell><mxCell id="e23" style="endArrow=block;html=1;strokeColor=#999999;" edge="1" parent="1" source="c20" target="c22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c24" value="&lt;b&gt;J11 — Grandes régions&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;York Shin, Kukuroo, Greed Island, NGL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2110" y="70" width="170" height="80" as="geometry" /></mxCell><mxCell id="e25" style="endArrow=block;html=1;strokeColor=#999999;" edge="1" parent="1" source="c22" target="c24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c26" value="&lt;b&gt;Fin — Équilibrage et finitions&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Modèles, animations, rééquilibrage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2300" y="70" width="170" height="80" as="geometry" /></mxCell><mxCell id="e27" style="endArrow=block;html=1;strokeColor=#999999;" edge="1" parent="1" source="c24" target="c26"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c28" value="Vert : fait · Orange : à venir" style="text;html=1;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="165" width="400" height="24" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>